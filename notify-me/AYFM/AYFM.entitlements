<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.kud.remindreply</string>
	</array>
	<!-- Time Sensitive Notifications — activate once the paid Apple Developer Program
	     enrollment is approved (purchased, pending approval as of 2026-06-02). To enable:
	     uncomment here AND in AYFMWidgetExtension.entitlements, then rebuild with
	     `xcodebuild ... -allowProvisioningUpdates`. Powers the "strength" feature.
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	-->
</dict>
</plist>
