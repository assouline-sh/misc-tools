<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.kud.remindreply</string>
	</array>
	<!-- See AYFM.entitlements: enable together once enrollment is approved (the widget
	     schedules reminders via QuickFlagIntent, so it needs the entitlement too).
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	-->
</dict>
</plist>
